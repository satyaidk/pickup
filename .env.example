# Pickup needs at least one of these keys. With both, OpenAI is used first and
# Gemini takes over automatically when OpenAI is out of credit, rate limited or down.

# OpenAI: https://platform.openai.com/api-keys (pay-as-you-go, needs billing)
OPENAI_API_KEY=

# Gemini: https://aistudio.google.com/apikey (has a free tier)
GEMINI_API_KEY=

# Optional
# PICKUP_PROVIDERS=openai,gemini       # order to try them in; put gemini first to prefer it
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low          # reasoning models only (gpt-5 and o-series)
# GEMINI_MODEL=gemini-flash-latest
# PORT=5173
# PICKUP_DEMO=1                        # canned example output, no API calls
